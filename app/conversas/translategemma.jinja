{#- Template de conversa do TranslateGemma, igual ao que o Ollama usava (blob e0a42594…): cada mensagem vira um turno,
    system entra como turno de usuário. Medido: o template que vem no GGUF pede código de idioma e responde em inglês. -#}
{%- for m in messages -%}
{%- if m.role == 'user' or m.role == 'system' -%}
<start_of_turn>user
{{ m.content }}<end_of_turn>
{% if loop.last %}<start_of_turn>model
{% endif -%}
{%- elif m.role == 'assistant' -%}
<start_of_turn>model
{{ m.content }}{% if not loop.last %}<end_of_turn>
{% endif -%}
{%- endif -%}
{%- endfor -%}
